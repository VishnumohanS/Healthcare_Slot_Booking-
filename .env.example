# Copy to .env (setupdev.bat does this automatically). Contains NO secrets.
APP_ENV=development

# SQLite file; relative paths are resolved against backend/
DATABASE_URL=sqlite:///./healthcare.db

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated list of allowed browser origins. '*' is rejected when APP_ENV=production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Appointment length in minutes (must divide 60: 10, 15, 20, 30, 60)
APPOINTMENT_DURATION_MINUTES=30

# Replace this with a random secret (at least 32 characters) before deployment.
SECRET_KEY=replace-this-with-a-long-random-secret-key

# Razorpay dashboard -> Test mode -> API Keys. Leave blank until test keys are created.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Read by the React/Vite frontend (only VITE_* variables are exposed to the browser)
VITE_API_BASE_URL=http://127.0.0.1:8000
